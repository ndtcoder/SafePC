{
  "action": {
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html",
    "default_title": "SafePC"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "SafePC — lọc web theo domain cho máy tính của con: chặn domain (kể cả theo danh mục), giới hạn thời gian theo domain, SafeSearch, chặn từ khóa tìm kiếm. Quy tắc do phụ huynh đặt trên Dashboard.",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "128": "icons/icon.svg",
    "16": "icons/icon.svg",
    "48": "icons/icon.svg"
  },
  "manifest_version": 3,
  "name": "SafePC",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "webNavigation",
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "version": "0.1.13",
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "blocked.html"
      ]
    }
  ]
}

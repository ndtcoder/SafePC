<Window x:Class="SafePC.Agent.Tray.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafePC — Cảnh báo" Width="360" Height="180"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="16" />
        <TextBlock x:Name="CountdownText" Margin="0,12,0,0" FontSize="14" FontWeight="Bold" />
        <Button Content="Đã hiểu" Width="120" Margin="0,20,0,0" HorizontalAlignment="Right" Click="OkButton_Click" />
    </StackPanel>
</Window>

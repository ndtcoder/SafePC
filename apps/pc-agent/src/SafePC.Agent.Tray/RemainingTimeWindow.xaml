<Window x:Class="SafePC.Agent.Tray.RemainingTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafePC — Thời gian còn lại" Width="360" Height="160"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="15" />
        <Button Content="Đóng" Width="100" Margin="0,20,0,0" HorizontalAlignment="Right" Click="CloseButton_Click" />
    </StackPanel>
</Window>

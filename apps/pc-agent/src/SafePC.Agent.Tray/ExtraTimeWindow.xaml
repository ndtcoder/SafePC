<Window x:Class="SafePC.Agent.Tray.ExtraTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafePC — Xin thêm giờ" Width="380" Height="310"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Xin thêm giờ" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Thêm bao nhiêu phút?" Margin="0,16,0,4" />
        <ComboBox x:Name="MinutesBox" SelectedIndex="0">
            <ComboBoxItem Content="15 phút" Tag="15" />
            <ComboBoxItem Content="30 phút" Tag="30" />
            <ComboBoxItem Content="60 phút" Tag="60" />
        </ComboBox>
        <TextBlock Text="Lý do" Margin="0,12,0,4" />
        <TextBox x:Name="ReasonBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="90" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Gửi yêu cầu" Width="120" Click="SendButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>

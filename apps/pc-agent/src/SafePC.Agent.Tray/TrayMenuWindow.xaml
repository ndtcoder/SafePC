<Window x:Class="SafePC.Agent.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafePC" SizeToContent="WidthAndHeight" MinWidth="220"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE5F1FB" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFCCE4F7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="White" BorderBrush="#FFABADB3" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="ScreenStatusText" Padding="12,8" FontSize="13" Foreground="#FF444444" />
            <Separator x:Name="ScreenStatusSeparator" Margin="0,4" />
            <Button Content="Xem thời gian còn lại" Click="RemainingButton_Click" />
            <Button Content="Nhắn tin với bố mẹ" Click="ChatButton_Click" />
            <Button Content="Xin thêm giờ" Click="ExtraTimeButton_Click" />
            <Separator Margin="0,4" />
            <Button Content="Thoát" Click="ExitButton_Click" />
        </StackPanel>
    </Border>
</Window>
